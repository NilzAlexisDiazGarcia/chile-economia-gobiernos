# Copia este archivo como ".env" y completa los valores.
# ".env" está en .gitignore: tus credenciales nunca llegan a GitHub.

# --- API Base de Datos Estadísticos (BDE) del Banco Central de Chile ---
# Registro gratuito en el sitio del Banco Central (servicio web de la BDE).
BCCH_USER=tu_correo@ejemplo.com
BCCH_PASS=tu_clave

# --- PostgreSQL (se usa desde la etapa 3) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=economia_chile
PG_USER=postgres
PG_PASS=tu_clave
