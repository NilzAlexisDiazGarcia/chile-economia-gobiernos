	/// Nombre corto y legible para segmentadores y títulos.
	column Nombre =
			SWITCH (
			    Indicadores[indicador],
			    "pib", "PIB",
			    "imacec", "IMACEC",
			    "ipc", "Inflación (IPC)",
			    "tpm", "Tasa de Política Monetaria",
			    "desempleo", "Desempleo",
			    "tipo_cambio", "Tipo de cambio",
			    "cobre", "Precio del cobre",
			    "deuda_bruta", "Deuda bruta",
			    "balance_fiscal", "Balance fiscal efectivo",
			    "balance_estructural", "Balance fiscal estructural",
			    "deuda_neta", "Deuda neta",
			    "fees", "Fondo de Estabilización (FEES)",
			    "frp", "Fondo de Reserva de Pensiones (FRP)",
			    "fondos_soberanos", "Fondos soberanos (total)",
			    "remuneraciones_reales_hist", "Salario real (hasta 2009)",
			    "remuneraciones_reales", "Salario real (desde 2010)",
			    "tasa_bonos_10_pesos", "Tasa de bonos en pesos a 10 años",
			    "tasa_bonos_10_uf", "Tasa real de bonos en UF a 10 años",
			    "intereses_deuda", "Gasto en intereses de la deuda",
			    "pib_nominal", "PIB nominal",
			    Indicadores[indicador]
			)
		dataType: string
		lineageTag: 2ceadbec-24e2-4f8b-ace7-67b5cdc6b7d2
		summarizeBy: none
		sortByColumn: Orden

	/// Orden de presentación: actividad, precios, empleo, fiscal, externo.
	column Orden =
			SWITCH (
			    Indicadores[indicador],
			    "pib", 1, "imacec", 2, "ipc", 3, "tpm", 4, "desempleo", 5,
			    "deuda_bruta", 6, "deuda_neta", 7, "balance_fiscal", 8, "balance_estructural", 9,
			    "cobre", 10, "tipo_cambio", 11, "fees", 12, "frp", 13, "fondos_soberanos", 14, "remuneraciones_reales_hist", 15, "remuneraciones_reales", 16, "tasa_bonos_10_pesos", 17, "tasa_bonos_10_uf", 18, "intereses_deuda", 19, "pib_nominal", 20,
			    99
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 394d6bf1-60fe-4f02-90e9-9debc803fa25
		summarizeBy: none

	partition Indicadores = m
		mode: import
		source =
