	/// Meta vigente y resultado del último año completo del gobierno.
	column 'Meta y resultado' =
			MetasFiscales[anio_evaluado] & ": meta " & FORMAT ( MetasFiscales[meta_vigente], "0.0" )
			    & " % → resultado " & FORMAT ( MetasFiscales[resultado], "0.0" ) & " %"
		dataType: string
		lineageTag: ac0fdbb9-5e74-446e-bd94-b5281750e9de
		summarizeBy: none

	partition MetasFiscales = m
		mode: import
		source =
				let
				  Origen = PostgreSQL.Database("localhost", "economia_chile"),
				  #"Navegación 1" = Origen{[Schema = "economia", Item = "dim_meta_fiscal"]}[Data]
				in
				  #"Navegación 1"

	annotation PBI_ResultType = Table

