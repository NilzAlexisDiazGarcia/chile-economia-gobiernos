	/// Nombre legible del indicador.
	column 'Nombre Indicador' =
			SWITCH (
			    Comparacion[indicador],
			    "crecimiento_pib", "Crecimiento del PIB",
			    "inflacion_promedio", "Inflación promedio",
			    "desempleo", "Desempleo",
			    "deuda_gobierno_general", "Deuda bruta (gobierno general)",
			    "balance_gobierno_general", "Balance fiscal (gobierno general)",
			    "control_corrupcion", "Control de la corrupción",
			    "crecimiento_pib_per_capita", "Crecimiento del PIB por habitante",
			    "poblacion", "Población",
			    Comparacion[indicador]
			)
		dataType: string
		lineageTag: dc8a9fd4-ec46-41b7-97ff-774e9db76681
		summarizeBy: none

	partition Comparacion = m
		mode: import
		source =
				let
				  Origen = PostgreSQL.Database("localhost", "economia_chile"),
				  #"Navegación 1" = Origen{[Schema = "economia", Item = "v_pbi_comparacion"]}[Data]
				in
				  #"Navegación 1"

	annotation PBI_ResultType = Table

