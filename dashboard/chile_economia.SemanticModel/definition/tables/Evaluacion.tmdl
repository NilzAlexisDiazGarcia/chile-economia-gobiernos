table Evaluacion
	lineageTag: 1750635c-3a99-4655-b657-f21162abbd78

	/// Resultado de cada criterio con su marca: ✓ favorable o ✗ desfavorable según la referencia.
	measure 'Resultado Evaluacion' =
			IF (
			    HASONEVALUE ( Evaluacion[criterio] ) && HASONEVALUE ( Gobiernos[etiqueta] ),
			    IF ( SELECTEDVALUE ( Evaluacion[favorable] ), "✓  ", "✗  " )
			        & SELECTEDVALUE ( Evaluacion[resultado] )
			)
		displayFolder: 7. Balance de cada gobierno
		lineageTag: 39c93b98-2c78-4178-b6c8-749c94c24de3

	column id_gobierno
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 52bdee21-032d-4cd1-8942-e5f35fac91a6
		summarizeBy: none
		sourceColumn: id_gobierno

		annotation SummarizationSetBy = Automatic

