	/// "Período de un solo gobierno" o "Período compartido (transición)", según si el período contiene un cambio de mando.
	column 'Tipo de período'
		dataType: string
		lineageTag: 0f54cded-030f-478d-815f-d7da4b68060e
		summarizeBy: none
		sourceColumn: Tipo de período

		annotation SummarizationSetBy = Automatic

	partition Observaciones = m
		mode: import
		source =
				let
				  Origen = PostgreSQL.Database("localhost", "economia_chile"),
				  #"Navegación 1" = Origen{[Schema = "economia", Item = "v_pbi_observacion"]}[Data],
				  #"Columnas con nombre cambiado" = Table.RenameColumns(#"Navegación 1",{{"es_transicion", "Tipo de período"}}),
				  #"Tipo de período como texto" = Table.TransformColumns(
				      #"Columnas con nombre cambiado",
				      {{"Tipo de período", each if _ then "Período compartido (transición)" else "Período de un solo gobierno", type text}}
				  )
				in
				  #"Tipo de período como texto"

	annotation PBI_ResultType = Table

