model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CL
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Eventos","Gobiernos","Indicadores","Observaciones","Comparacion","Explicaciones"]

annotation PBI_ProTooling = ["DevMode"]

ref table Eventos
ref table Gobiernos
ref table Indicadores
ref table Observaciones
ref table Comparacion
ref table Explicaciones

ref cultureInfo es-ES

