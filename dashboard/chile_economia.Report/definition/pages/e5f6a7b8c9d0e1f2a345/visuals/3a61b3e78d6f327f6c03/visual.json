    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Cómo se evalúa",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Crecimiento: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "sobre el promedio de Perú, Colombia, México y Brasil.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Inflación: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "en el rango de 2 % a 4 % la mayoría de los meses. La controla el Banco Central.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Desempleo: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "entregar menos del recibido.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Meta fiscal: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "balance estructural del último año igual o mejor que la meta vigente.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Deuda neta: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "entregar igual o menos deuda, descontados los fondos.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "FEES: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "entregar igual o más fondo para crisis. El FRP no cuenta: recibe aportes por ley.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pobreza y salarios: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "menos pobreza (CASEN) y salarios que suban más que los precios.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La meta fiscal, la deuda y los fondos dependen principalmente del gobierno.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#6B6B6B",
                      "fontStyle": "italic"
                    }
                  }
                ]
              }
            ]
          }
