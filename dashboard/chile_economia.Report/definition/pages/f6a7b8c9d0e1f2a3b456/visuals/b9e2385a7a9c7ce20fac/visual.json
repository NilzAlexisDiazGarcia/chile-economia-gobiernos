  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Por qué dejó de crecer",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "15pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. La productividad se estancó: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "lleva unos 16 años sin aportar al crecimiento (CNEP), por la desaceleración mundial, la rigidez laboral, los permisos para invertir y la menor ley del mineral.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Terminó el auge del cobre: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "la inversión minera cayó desde 2013–2014 (FMI).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. La capacidad de crecer se redujo a la mitad: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "de cerca de 5 % estimado en 2011 a 2 % hoy (DIPRES y Banco Central).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Hubo incertidumbre local: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "por las reformas de 2014 (FMI) y en 2021 (Banco Central).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
