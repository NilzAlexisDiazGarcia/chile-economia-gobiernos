  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Por qué se endeudó",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "15pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Gasto permanente mayor que el ingreso permanente: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "23,8 % y 22 % del PIB en 2008–2023 (CFA); déficit en 14 de 17 años desde 2009.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. El menor crecimiento redujo la recaudación esperada: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "crecer poco y endeudarse se alimentan entre sí (DIPRES).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Dos shocks: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "la crisis de 2009 y la pandemia (déficit estructural de −10,7 % en 2021).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Metas fiscales cambiadas a discreción: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "la meta inicial de cada gobierno se cumplió en 9 de 21 años (DIPRES).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5. Deuda más cara: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "intereses de 0,47 % del PIB en 2008 a 1,24 % en 2025 (BCCh).",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "6. Ingresos sobrestimados: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  },
                  {
                    "value": "en 2024–2025, según el CFA.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#2B2B2B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
